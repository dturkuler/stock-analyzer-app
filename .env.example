# ======================================================================
# Stock Analyzer Platform — Environment Configuration Template
# Copy this file to .env and configure your parameters:
#   cp .env.example .env
# ======================================================================

# Admin Panel Password (used for web UI login)
ADMIN_PASSWORD=admin1234

# 9Router / OpenAI-Compatible LLM API Configuration
LLM_BASE_URL=https://9router.turkuler.tr/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=code_combo

# Application Language & Timeout Settings
OUTPUT_LANGUAGE=TR
LLM_TIMEOUT=120
CRON_DELAY_SECONDS=15
