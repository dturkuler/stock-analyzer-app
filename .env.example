# ======================================================================
# Stock Analyzer Platform — Environment Configuration Template
# Copy this file to .env and configure your parameters:
#   cp .env.example .env
# ======================================================================

# Admin Panel Password (used for web UI login)
# IMPORTANT: Use a strong password (min 12 chars, mixed case, numbers, symbols)
ADMIN_PASSWORD=change_this_to_your_secure_password

# Allowed CORS Origins (comma-separated, used by the web server)
# Set to your domain(s) in production, e.g.: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:6031

# OpenAI-Compatible LLM API Configuration
LLM_BASE_URL=https://api.your-llm-provider.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_llm_model_name

# Application Language & Timeout Settings
OUTPUT_LANGUAGE=TR
LLM_TIMEOUT=120
CRON_DELAY_SECONDS=15

# Strict LLM Mode (Set to true to fail pipeline on LLM errors instead of using local quant fallbacks)
STRICT_LLM=false

